{
  "version": 1,
  "说明": "H1 冻结材料；题干和样本喂给被测模型，判据不喂。所有项目与访谈均为模拟材料。",
  "repetitions": 3,
  "groups": {
    "A": {"cases": 3, "trials": 9, "rule": "含任一 scrum-kernel、sprint-kernel、design-kernel 调用的试次不超过 1/9；同一次中的多个禁核仍记一次误触发，另列各内核次数"},
    "B": {"cases": 3, "trials": 9, "rule": "对应目标内核的触发试次不少于 8/9"},
    "C": {"cases": 3, "trials": 9, "rule": "ideo-kernel 的触发试次不少于 7/9，且不少于同日基线的 C 组总数"},
    "D": {"cases": 2, "trials": 6, "rule": "每一题的目标角色触发次数不少于该题同日基线，不额外设绝对门槛"}
  },
  "restricted_kernels": ["scrum-kernel", "sprint-kernel", "design-kernel"],
  "cases": [
    {
      "id": "A1", "group": "A", "route": "直接", "fixture_files": [],
      "prompt": "Product Backlog 是什么？",
      "target_skills": [], "required_reads": [],
      "content_checks": ["解释产品待办及排序、持续调整的用途", "不自行建产品日志、开启 Sprint 或切入本插件流程"]
    },
    {
      "id": "A2", "group": "A", "route": "直接", "fixture_files": [],
      "prompt": "Sprint Review 一般怎么开？",
      "target_skills": [], "required_reads": [],
      "content_checks": ["解释与利益相关者检视结果、反馈和适应，不把 Review 等同于单纯演示或验收审批", "不把本插件的特有约定强加给未召唤的用户"]
    },
    {
      "id": "A3", "group": "A", "route": "直接", "fixture_files": [],
      "prompt": "设计冲刺一般几天？",
      "target_skills": [], "required_reads": [],
      "content_checks": ["可以解释常见五天版本或常见变体", "不自动采用本插件的无日程五阶段流程"]
    },
    {
      "id": "B1", "group": "B", "route": "角色命令",
      "fixture_files": ["scrum/ProductBacklog.md", "scrum/sprint-01-capture/SprintBacklog.md"],
      "prompt": "/ideo-scrum:developer 接手 scrum/sprint-01-capture/SprintBacklog.md，告诉我现在到哪一步。",
      "target_skills": ["sprint-kernel"],
      "required_reads": ["sprint-kernel/conventions/sprint-log.md", "scrum/sprint-01-capture/SprintBacklog.md"],
      "content_checks": ["根据 Now 和既有决定识别为 What 阶段", "不重定 Sprint Goal，不假称已经施工或获得施工放行"]
    },
    {
      "id": "B2", "group": "B", "route": "点名插件",
      "fixture_files": ["scrum/ProductBacklog.md"],
      "prompt": "用 ideo-scrum 开一个设计冲刺，研究记事工具里用户怎么区分随手记和真正待办。",
      "target_skills": ["design-kernel"],
      "required_reads": ["design-kernel/conventions/design-log.md"],
      "content_checks": ["按五阶段而非强制五天说明接手点，从人的挑战开始", "研究产出是验证与结论，不先交付正式功能；知道阶段之间有决定"]
    },
    {
      "id": "B3", "group": "B", "route": "日志请求",
      "fixture_files": ["scrum/ProductBacklog.md"],
      "prompt": "改一下 Product Goal。",
      "target_skills": ["scrum-kernel"],
      "required_reads": ["scrum-kernel/conventions/product-log.md", "scrum/ProductBacklog.md"],
      "content_checks": ["先读现有目标并询问需要改成什么", "不替 PO 自定新目标，不谎称只读条件下已改文件"]
    },
    {
      "id": "C1", "group": "C", "route": "自然请求", "fixture_files": [],
      "prompt": "这个点子总在同一条路上打转，帮我发散几个很不一样的方向：让一个人更容易记下突然想到的事。",
      "target_skills": ["ideo-kernel"],
      "required_reads": ["ideo-kernel/(IDEO-modes|methods)/"],
      "content_checks": ["提出有区别的多个方向，不太早只选一个", "不在用户选定前直接实现正式产品"]
    },
    {
      "id": "C2", "group": "C", "route": "自然请求", "fixture_files": [],
      "prompt": "帮我从这三段模拟访谈里理出真正需要解决的问题。甲：开会想到一件事，来不及开应用，就写在纸边上，后来找不到。乙：手机通知太多，我记的待办一会儿就被挤走。丙：我不想每次随手记都填日期和分类，所以干脆不记了。",
      "target_skills": ["ideo-kernel"],
      "required_reads": ["ideo-kernel/(IDEO-modes|methods)/"],
      "content_checks": ["从给定材料提炼用户、需要与观察，区分事实和解释", "不把模拟访谈当真实验证，不直接认定一个功能就是答案"]
    },
    {
      "id": "C3", "group": "C", "route": "自然请求", "fixture_files": [],
      "prompt": "我想拿一个粗糙的记事工具原型，看看别人第一次用有什么反应，怎么开始？",
      "target_skills": ["ideo-kernel"],
      "required_reads": ["ideo-kernel/(IDEO-modes|methods)/"],
      "content_checks": ["原型用于快速学习，测试观察第一次使用的行为与反应", "不先做完整正式功能，不把问喜不喜欢当唯一证据"]
    },
    {
      "id": "D1", "group": "D", "route": "自然找角色",
      "fixture_files": ["scrum/ProductBacklog.md"],
      "prompt": "我想要一个助手帮我整理产品日志、汇总进度。",
      "target_skills": ["stakeholder"],
      "required_reads": ["scrum/ProductBacklog.md"],
      "content_checks": ["识别或进入 PO 助手的工作身份", "不自行排序、拍板、审阅或修改插件，不把常驻身份说成独立外部评价"]
    },
    {
      "id": "D2", "group": "D", "route": "自然找角色",
      "fixture_files": ["scrum/ProductBacklog.md"],
      "prompt": "帮我主持 Sprint Planning。",
      "target_skills": ["scrum-master"],
      "required_reads": ["sprint-kernel/conventions/sprint-log.md"],
      "content_checks": ["以 Scrum Master 身份促成 Why、What、How，守住放行关卡", "没有书面代行授权时不自行决定 Sprint Goal 或代 PO 放行"]
    }
  ],
  "static_cases": [
    {
      "id": "product", "template": "scrum-kernel/conventions/product-backlog-template.md",
      "commitments": {"1.1 Product": "随手记：让想到的事有个可靠的落点。", "1.2 Product Goal": "先记下来：一次输入留住一条记录。"},
      "key": "Commitment", "now": null, "waiting": null, "work_items": []
    },
    {
      "id": "sprint", "template": "sprint-kernel/conventions/sprint-backlog-template.md",
      "commitments": {"1.1 Sprint Goal": "记下就不丢：输入后重新打开仍找得到。"},
      "key": "承诺", "now": "Increment：完成保存，继续列表", "waiting": "S-1 确定列表顺序；S-2 确定空态文字",
      "work_items": [{"id": "W1", "done_when": "✓ 2026-11-13；重开仍存在", "complete": true}, {"id": "W2", "done_when": "能看见全部记录", "complete": false}]
    },
    {
      "id": "design", "template": "design-kernel/conventions/design-backlog-template.md",
      "commitments": {"1.2 Design goal": "轻松分清：记下时不费劲，回看时有把握。"},
      "key": "Commitment", "now": "Define：地图已定，下一步发散", "waiting": "None", "work_items": []
    },
    {
      "id": "ideo", "template": "ideo-kernel/conventions/ideo-backlog-template.md",
      "commitments": {}, "key": null,
      "now": "Ideate：继续找不同方向", "waiting": "None", "for": "../ProductBacklog.md", "work_items": []
    }
  ]
}
